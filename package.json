{
  "name": "agent-plugin-cc",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project packages/runtime/tsconfig.json && tsc --noEmit --project packages/plugin/tsconfig.json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "tsup": "^8.5.1",
    "vitest": "^4.1.2",
    "@types/node": "^25.5.2",
    "eslint": "^10.1.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "typescript-eslint": "^8.58.0",
    "prettier": "^3.8.1"
  }
}
